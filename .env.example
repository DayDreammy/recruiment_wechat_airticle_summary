# recruiment-article-summary runtime env (copy to .env, gitignored)
DATABASE_URL=sqlite:////Users/yy/touzi/projects/recruiment-article-summary/data/message_monitor.db
WECHAT_SQLITE_DB_PATH=data/message_monitor.db
PDFSUMMARY_CONFIG=config.json
PDF_DIR=pdfs
OUTPUT_DIR=data
# 本地 wechat2rss 聚合源（build_recruitment_feed.py）
WECHAT2RSS_BASE=http://127.0.0.1:8081
WECHAT2RSS_RSS_TOKEN=<wechat2rss RSS_TOKEN，或留空由 run_fetch.sh 从容器读取>
# 聚合 feed 上限（条数）与开关
RECRUIT_FEED_MAX_ITEMS=300
FETCH_SKIP_PDF=0
# 订阅邮件 SMTP（163 邮箱授权码，不入库）
SMTP_EMAIL=daydreammy@163.com
SMTP_PASSWORD=<163 邮箱授权码>
